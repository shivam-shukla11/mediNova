    "express-validator": "^7.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.11.0",
    "node-cron": "^3.0.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "nodemon": "^3.0.0",
    "prettier": "^3.3.2"
  },
  "engines": {
    "node": ">=24 <25"
